# =============================================================================
# PortfolioLab — modèle de configuration
#
# Copier ce fichier en `.env.local` (web) ou `.env` (passerelle) et renseigner
# les valeurs réelles. `.gitignore` exclut tous les `.env*` sauf ce modèle.
#
# AUCUNE VALEUR RÉELLE NE DOIT ÊTRE ÉCRITE ICI NI COMMITÉE.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données et authentification — Lot 02
# -----------------------------------------------------------------------------

# Chaîne de connexion PostgreSQL. Serveur uniquement.
DATABASE_URL=

# URL du projet Supabase. Publique par nature.
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme Supabase. Publique par conception : elle n'ouvre que ce que les
# politiques RLS autorisent. Toutes les tables utilisateur doivent avoir RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role Supabase. SECRET ABSOLU : contourne RLS.
# Ne jamais préfixer par NEXT_PUBLIC_, ne jamais l'envoyer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Passerelle de marché — Lot 05
# -----------------------------------------------------------------------------

# Port d'écoute de la passerelle. Défaut : 4100.
MARKET_GATEWAY_PORT=4100

# Secret partagé entre la PWA et la passerelle pour authentifier le canal live.
# La PWA ne le voit jamais : elle demande un jeton court à son propre backend.
# Minimum 32 caractères — un secret plus court rend le HMAC attaquable hors
# ligne. Sans cette variable, le canal temps réel refuse toute connexion.
# Générer par exemple avec : openssl rand -base64 48
MARKET_GATEWAY_SHARED_SECRET=

# Connexions simultanées autorisées par utilisateur. Défaut : 5.
# Plusieurs onglets ou appareils sont légitimes ; un nombre illimité
# permettrait d'épuiser la mémoire de la passerelle avec une seule identité.
MARKET_GATEWAY_MAX_CONNECTIONS_PER_USER=5

# URL de la passerelle vue par le backend de la PWA.
MARKET_GATEWAY_URL=http://127.0.0.1:4100

# -----------------------------------------------------------------------------
# Fournisseurs de données de marché — Lots 04 à 07
#
# Aucune clé n'est nécessaire pour développer : le fournisseur `mock` produit
# des données déterministes, marquées comme fictives dans l'interface.
# -----------------------------------------------------------------------------

# Fournisseur actif : mock | twelvedata | massive | eodhd
MARKET_DATA_PROVIDER=mock

# Actions, ETF internationaux, FX. https://twelvedata.com/docs
TWELVE_DATA_API_KEY=

# Actions et options américaines. https://massive.com/docs
MASSIVE_API_KEY=

# Recherche par ISIN, fonds, EOD. https://eodhd.com/financial-apis
EODHD_API_KEY=

# Normalisation d'identifiants uniquement, jamais de prix.
# https://www.openfigi.com/api/documentation
OPENFIGI_API_KEY=

# -----------------------------------------------------------------------------
# Exploitation
# -----------------------------------------------------------------------------

# debug | info | warn | error
LOG_LEVEL=info
