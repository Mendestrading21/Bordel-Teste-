# =============================================================================
# PortfolioLab — modèle de configuration
#
# Copier ce fichier en `.env.local` (web) ou `.env` (passerelle) et renseigner
# les valeurs réelles. `.gitignore` exclut tous les `.env*` sauf ce modèle.
#
# AUCUNE VALEUR RÉELLE NE DOIT ÊTRE ÉCRITE ICI NI COMMITÉE.
# =============================================================================

# Base de données et authentification
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Passerelle de marché
MARKET_GATEWAY_PORT=4100
MARKET_GATEWAY_SHARED_SECRET=
MARKET_GATEWAY_MAX_CONNECTIONS_PER_USER=5
MARKET_GATEWAY_URL=http://127.0.0.1:4100

# Mode global : mock | demo | live
MARKET_DATA_MODE=mock
MARKET_DATA_PROVIDER=mock
MARKET_DATA_ENABLED_PROVIDERS=mock

# -----------------------------------------------------------------------------
# Tier A — fournisseurs principaux
# -----------------------------------------------------------------------------

# EODHD — discovery/ISIN, stocks, ETF, funds, indices, EOD, FX/crypto.
# Demo officiel : la clé littérale `demo` fonctionne sur une liste limitée de
# symboles (notamment AAPL.US, TSLA.US, VTI.US, BTC-USD.CC, EURUSD.FOREX selon
# endpoint). Search API exige une clé personnelle gratuite ou payante.
# https://eodhd.com/financial-apis/
EODHD_API_KEY=
EODHD_ENABLED=false
EODHD_MODE=disabled
# Flux temps réel EODHD. Un socket par canal : `us` (actions/ETF américains),
# `forex` et `crypto`. Les actions non américaines n'ont PAS de canal — les y
# abonner donnerait une souscription acceptée qui ne cote jamais.
# Le flux n'est activé que si l'application fournit une fabrique de socket ;
# sans elle, l'adaptateur annonce `streaming: false` plutôt que de promettre un
# flux qu'aucune implémentation ne sait ouvrir.
# https://eodhd.com/financial-apis/new-real-time-data-api-websockets
EODHD_STREAM_ENABLED=false
EODHD_STREAM_BASE_URL=wss://ws.eodhistoricaldata.com/ws

# Twelve Data — global stocks/ETF/funds, FX, crypto, commodities, WebSocket.
# `demo` peut être utilisé sur les symboles de trial. La fraîcheur n'est JAMAIS
# déduite de la présence d'une clé : renseigner explicitement LIVE uniquement si
# le plan/licence réellement souscrit le garantit.
# https://twelvedata.com/docs
TWELVE_DATA_API_KEY=
TWELVE_DATA_ENABLED=false
TWELVE_DATA_MODE=disabled
TWELVE_DATA_FRESHNESS=DELAYED
TWELVE_DATA_DELAY_MINUTES=

# Massive — US stocks/options/futures/indices/FX/crypto, REST + WebSocket.
# https://massive.com/docs
MASSIVE_API_KEY=
MASSIVE_ENABLED=false
MASSIVE_MODE=disabled

# CoinGecko — spécialiste crypto / fallback de couverture.
# COINGECKO_MODE=demo sans clé utilise le Public API keyless quand disponible ;
# avec une clé Demo, elle reste côté serveur. `live` désigne ici le domaine Pro,
# pas une promesse de tick-by-tick : l'adaptateur REST reste DELAYED.
# https://docs.coingecko.com/
COINGECKO_API_KEY=
COINGECKO_ENABLED=false
COINGECKO_MODE=disabled

# OpenFIGI — identifiants seulement, jamais une source de prix.
# https://www.openfigi.com/api/documentation
OPENFIGI_API_KEY=
OPENFIGI_ENABLED=false

# FINRA TRACE — fixed income US transactionnel. Un dernier trade TRACE n'est
# jamais présenté comme un bid/ask live.
# https://developer.finra.org/
FINRA_API_KEY=
FINRA_ENABLED=false

# -----------------------------------------------------------------------------
# Tier B — fallbacks optionnels
# -----------------------------------------------------------------------------
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_ENABLED=false
FINNHUB_API_KEY=
FINNHUB_ENABLED=false

# -----------------------------------------------------------------------------
# Tier C — institutionnel / seulement si la matrice prouve le besoin
# -----------------------------------------------------------------------------
FACTSET_API_KEY=
FACTSET_API_SECRET=
FACTSET_ENABLED=false

# Résilience / tuning
MARKET_DATA_REST_TIMEOUT_MS=8000
MARKET_DATA_MAX_RETRIES=2
MARKET_DATA_CIRCUIT_BREAKER_FAILURES=5
MARKET_DATA_CIRCUIT_BREAKER_RESET_MS=30000
MARKET_DATA_STALE_AFTER_SECONDS_LIVE=30
MARKET_DATA_STALE_AFTER_SECONDS_DELAYED=1200
MARKET_DATA_WS_RECONNECT_MIN_MS=1000
MARKET_DATA_WS_RECONNECT_MAX_MS=30000

# Exploitation
LOG_LEVEL=info
