{
  "name": "portfolio-lab",
  "version": "0.1.0",
  "private": true,
  "description": "PortfolioLab — PWA privée de suivi patrimonial multi-actifs consolidé en CHF.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --sequential run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "build": "pnpm -r --sequential run build",
    "dev": "pnpm --filter @portfolio-lab/web run dev",
    "dev:gateway": "pnpm --filter @portfolio-lab/market-gateway run dev",
    "setup": "tsx scripts/setup.mts",
    "demo": "tsx scripts/setup.mts --demo",
    "icons": "node scripts/generate-icons.mjs",
    "coverage:matrix": "tsx scripts/coverage-matrix.mts",
    "market:smoke": "tsx scripts/market-data-smoke.mts",
    "creer-acces": "tsx scripts/creer-acces.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@portfolio-lab/database": "workspace:*",
    "@portfolio-lab/domain": "workspace:*",
    "@portfolio-lab/market-data": "workspace:*",
    "@portfolio-lab/portfolio-engine": "workspace:*",
    "@portfolio-lab/security": "workspace:*",
    "@portfolio-lab/ui": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.18.0",
    "globals": "^17.11.0",
    "pg": "^8.23.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@tailwindcss/oxide"
    ],
    "overrides": {
      "postcss": "^8.5.23",
      "sharp": "^0.35.0"
    }
  }
}
